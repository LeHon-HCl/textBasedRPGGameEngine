#!/bin/sh
# develop.md 约束 9 的机械化兜底：禁止向 main 推送。
# git 经 stdin 传入待推送的 ref 行：<local-ref> <local-sha> <remote-ref> <remote-sha>。
# 与 pre-commit 互补：pre-commit 挡在编辑期，pre-push 挡在发布期——后者是真正
# 不可撤销的一步（--no-verify 提交后仍会被这里拦下）。
# 启用方式：pnpm install（prepare 脚本自动 git config core.hooksPath .githooks）。
# 紧急绕过：git push --no-verify（须在 PR/反思报告中说明原因）。
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
    echo "✖ 禁止向 $remote_ref 推送（docs/develop.md 约束 9：main 分支禁止直接提交）。" >&2
    echo "  正确流程：推送功能分支后创建 PR：gh pr create --base main" >&2
    echo "  确需绕过：git push --no-verify" >&2
    status=1
  fi
done
exit $status
