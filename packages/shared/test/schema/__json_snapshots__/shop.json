{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nameKey": {
      "type": "string",
      "minLength": 1,
      "refKind": "text"
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "refKind": "item"
          },
          "showIf": {
            "type": "string",
            "minLength": 1
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "restock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["item"],
        "additionalProperties": false
      }
    },
    "priceBuy": {
      "type": "string",
      "minLength": 1
    },
    "priceSell": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "requireFlag": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["id", "nameKey", "entries", "priceBuy", "priceSell"],
  "additionalProperties": false
}
