{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nameKey": {
      "type": "string",
      "minLength": 1,
      "refKind": "text"
    },
    "init": {
      "type": "number"
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "at": {
            "type": "number"
          },
          "nameKey": {
            "type": "string",
            "minLength": 1,
            "refKind": "text"
          }
        },
        "required": ["id", "at", "nameKey"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "nameKey", "init"],
  "additionalProperties": false
}
