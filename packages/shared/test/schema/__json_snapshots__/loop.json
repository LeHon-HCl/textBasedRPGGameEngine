                  "type": "string"
                }
              }
            },
            "required": ["whitelist"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "blacklist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["blacklist"],
            "additionalProperties": false
          }
        ]
      }
    }
