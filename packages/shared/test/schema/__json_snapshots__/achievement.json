{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nameKey": {
      "type": "string",
      "minLength": 1,
      "refKind": "text"
    },
    "when": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": ["normal", "progress", "hidden"]
    },
    "progressExpr": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "group": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["id", "nameKey", "when", "points", "type"],
  "additionalProperties": false
}
