{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "numeric": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "init": {
            "type": "number"
          },
          "show": {
            "type": "boolean"
          }
        },
        "required": ["min", "max", "init", "show"],
        "additionalProperties": false
      }
    },
    "level": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "levels": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "refKind": "text"
            }
          },
          "init": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["levels", "init"],
        "additionalProperties": false
      }
    },
    "derived": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "formula": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["formula"],
        "additionalProperties": false
      }
    }
  },
  "required": ["numeric", "level", "derived"],
  "additionalProperties": false
}
