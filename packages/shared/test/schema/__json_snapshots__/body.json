{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "parts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "values": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "default": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["values", "default"],
        "additionalProperties": false
      }
    },
    "pronouns": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "enum": ["by_part"]
        },
        "part": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "map": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": ["rule", "part", "map"],
      "additionalProperties": false
    }
  },
  "required": ["parts"],
  "additionalProperties": false
}
