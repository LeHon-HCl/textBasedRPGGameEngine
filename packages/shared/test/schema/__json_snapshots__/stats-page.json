{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "groups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameKey": {
            "type": "string",
            "minLength": 1,
            "refKind": "text"
          },
          "entries": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "expr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "showIf": {
                      "type": "string",
                      "minLength": 1
                    },
                    "style": {
                      "type": "string",
                      "enum": ["bar", "radar", "text"]
                    }
                  },
                  "required": ["expr"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "refKind": "text"
                    },
                    "showIf": {
                      "type": "string",
                      "minLength": 1
                    },
                    "style": {
                      "type": "string",
                      "enum": ["bar", "radar", "text"]
                    }
                  },
                  "required": ["key"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["id", "nameKey", "entries"],
        "additionalProperties": false
      }
    }
  },
  "required": ["groups"],
  "additionalProperties": false
}
