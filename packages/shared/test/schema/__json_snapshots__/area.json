{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nameKey": {
      "type": "string",
      "minLength": 1,
      "refKind": "text"
    },
    "locations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nameKey": {
            "type": "string",
            "minLength": 1,
            "refKind": "text"
          },
          "unlockIf": {
            "type": "string",
            "minLength": 1
          },
          "moveCost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mapPos": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "entryScene": {
            "type": "string",
            "refKind": "scene"
          }
        },
        "required": ["nameKey", "moveCost", "mapPos"],
        "additionalProperties": false
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "bg": {
          "type": "string",
          "refKind": "media"
        },
        "bgm": {
          "type": "string",
          "refKind": "media"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "nameKey", "locations"],
  "additionalProperties": false
}
