{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "loop": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "player": {
      "type": "object",
      "properties": {
        "attrs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "skills": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "exp": {
                "type": "number"
              }
            },
            "required": ["value", "exp"],
            "additionalProperties": false
          }
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "remaining": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "stacks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "string"
              }
            },
            "required": ["id"],
            "additionalProperties": false
          }
        },
        "body": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "bodyProgress": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "bodyTemp": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "original": {
                "type": "string"
              },
              "remainingSlots": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["original", "remainingSlots"],
            "additionalProperties": false
          }
        },
        "equip": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "refKind": "item"
          }
        },
        "outfit": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "refKind": "item"
            }
          }
        },
        "bag": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "refKind": "item"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["itemId", "count"],
            "additionalProperties": false
          }
        },
        "wallet": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "derived": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "outfitPresets": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "refKind": "item"
              }
            }
          }
        },
        "wornMeta": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "refKind": "item"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "wornSlots": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "durability": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["wornSlots"],
            "additionalProperties": false
          }
        },
        "bootstrap": {
          "type": "object",
          "properties": {
            "perks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "name": {
              "type": "string"
            }
          },
          "required": ["perks", "name"],
          "additionalProperties": false
        }
      },
      "required": [
        "attrs",
        "skills",
        "statuses",
        "body",
        "equip",
        "outfit",
        "bag",
        "wallet",
        "derived",
        "bootstrap"
      ],
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "properties": {
        "time": {
          "type": "object",
          "properties": {
            "day": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "slotIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "week": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "month": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["day", "slotIndex"],
          "additionalProperties": false
        },
        "unlockedAreas": {
          "type": "array",
          "items": {
            "type": "string",
            "refKind": "area"
          }
        },
        "flags": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": ["boolean", "number", "string"]
          }
        },
        "counters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "eventCooldowns": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "lastDay": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "fired": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["lastDay", "fired"],
            "additionalProperties": false
          }
        }
      },
      "required": ["time", "unlockedAreas", "flags", "counters", "eventCooldowns"],
      "additionalProperties": false
    },
    "npcs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "refKind": "npc"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "favor": {
            "type": "number"
          },
          "stage": {
            "type": "string"
          },
          "met": {
            "type": "boolean"
          },
          "flags": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": ["boolean", "number", "string"]
            }
          }
        },
        "required": ["favor", "met", "flags"],
        "additionalProperties": false
      }
    },
    "factions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "refKind": "faction"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "quests": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "refKind": "quest"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": ["undiscovered", "available", "active", "ready_to_submit", "done", "failed"]
          },
          "stage": {
            "type": "string"
          },
          "objectives": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "startedDay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["state", "objectives"],
        "additionalProperties": false
      }
    },
    "seen": {
      "type": "object",
      "properties": {
        "scenes": {
          "type": "array",
          "items": {
            "type": "string",
            "refKind": "scene"
          }
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string",
            "refKind": "scene"
          }
        },
        "cg": {
          "type": "array",
          "items": {
            "type": "string",
            "refKind": "media"
          }
        },
        "endings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "codex": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": ["scenes", "gallery", "cg", "endings", "codex"],
      "additionalProperties": false
    },
    "readStats": {
      "type": "object",
      "properties": {
        "playSeconds": {
          "type": "number",
          "minimum": 0
        },
        "eventCounts": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "checks": {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "successes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["attempts", "successes"],
          "additionalProperties": false
        },
        "battles": {
          "type": "object",
          "properties": {
            "wins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "losses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "escapes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["wins", "losses", "escapes"],
          "additionalProperties": false
        }
      },
      "required": ["playSeconds", "eventCounts", "checks", "battles"],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "lang": {
          "type": "string",
          "minLength": 1
        },
        "textSpeed": {
          "type": "number",
          "minimum": 0
        },
        "fontSize": {
          "type": "number",
          "minimum": 1
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1
        },
        "bgmOn": {
          "type": "boolean"
        },
        "sfxOn": {
          "type": "boolean"
        },
        "imagesOn": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "disabledTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themeId": {
          "type": "string"
        },
        "wizardDone": {
          "type": "boolean"
        }
      },
      "required": [
        "lang",
        "textSpeed",
        "fontSize",
        "lineHeight",
        "bgmOn",
        "sfxOn",
        "imagesOn",
        "reducedMotion",
        "disabledTags",
        "wizardDone"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "loop",
    "player",
    "world",
    "npcs",
    "factions",
    "quests",
    "seen",
    "readStats",
    "settings"
  ],
  "additionalProperties": false
}
